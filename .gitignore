*.ap_
*.dex
*.class
bin/
gen/

# Keystores / signing — never commit real (release) ones.
*.jks
*.keystore
!**/debug.keystore.template
# The shared debug keystore is committed so every machine/CI signs debug builds
# with the same cert. It is public: never trust its fingerprint in a production
# assetlinks.json or server origin list.
!apps/android/app/debug.keystore

