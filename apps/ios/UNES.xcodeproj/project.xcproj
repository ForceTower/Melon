{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "pt-BR",
    "supported": [
      "Base",
      "en",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "UNESKit",
    }, {
      "kind": "remote",
      "repository": "https://github.com/firebase/firebase-ios-sdk",
      "version": {
        "up-to-next-major-version": "12.16.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/PostHog/posthog-ios.git",
      "version": {
        "up-to-next-major-version": "3.66.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/ForceTower/lever-swift.git",
      "version": {
        "up-to-next-major-version": "0.1.1",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "UNES",
      "target-membership": [
        "UNES",
      ],
      "membership-exceptions": [
        {
          "target": "UNES",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "UNESWatch",
          "inclusions": [
            "AppIcons/Aurora.icon",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "UNESWidgets",
      "target-membership": [
        "UNESWidgets",
      ],
      "membership-exceptions": [
        {
          "target": "UNESWidgets",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "UNESWatch",
      "target-membership": [
        "UNESWatch",
      ],
      "membership-exceptions": [
        {
          "target": "UNESWatch",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "UNESWatchWidgets",
      "target-membership": [
        "UNESWatchWidgets",
      ],
      "membership-exceptions": [
        {
          "target": "UNESWatchWidgets",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "UNESIntentTests", "target-membership": [ "UNESIntentTests" ] },
    { "path": "<PROJECT>/UNESKit" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/UNES.app", "id": "6CF5E0FB2FF5A43F00953BC4", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/UNESWidgets.appex", "id": "CAFECAFE0000000000000007", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "UNES/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/UNESWatch.app", "id": "CAFEAA000000000000000003", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "UNES/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/UNESWatchWidgets.appex", "id": "CAFEAA000000000000000013", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "UNESWatch/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/UNESIntentTests.xctest", "id": "AB1E57000000000000000001", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "UNES",
      "id": "6CF5E0FA2FF5A43F00953BC4",
      "product": "Products/UNES.app",
      "product-type": "application",
      "dependencies": [
        "UNESWidgets",
        "UNESWatch",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "script",
          "name": "Upload Symbols (Firebase Crashlytics)",
          "log-environment-variables": true,
          "input-paths": [
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${TARGET_NAME}",
            "$(SRCROOT)/$(BUILT_PRODUCTS_DIR)/$(INFOPLIST_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"${BUILD_DIR%/Build/*}/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/run\"\n",
        },
      ],
      "package-product-members": [
        {
          "product-name": "UNESKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAnalyticsCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCrashlytics",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseInstallations",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseMessaging",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "lever-swift",
          "product-name": "Lever",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "posthog-ios",
          "product-name": "PostHog",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES": "BaseSans NowShip Ocean Paper Stripped",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "Aurora",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "UNES/UNES.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "5GH6Q6KS69",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "UNES/Info.plist",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSCameraUsageDescription": "A câmera tira sua foto de perfil e digitaliza folhas de material de estudo para envio em PDF.",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "O Face ID confirma que é você antes de mostrar a senha guardada.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Sua localização mostra os pontos de ônibus mais perto e você no mapa do trajeto. Ela não sai do aparelho.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.6",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.9.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.forcetower.unes.ios",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
