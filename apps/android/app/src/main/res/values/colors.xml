<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors the design-system NightFixed (#12100E) that the in-app Compose
         SplashScreen paints as its base, so the OS cold-start splash hands off
         to the first Compose frame with no color flash. -->
    <color name="splash_background">#12100E</color>

    <!-- Tint the system applies to the notification small icon and app name.
         Mirrors the design-system BrandMagenta, which is the one brand color
         that keeps contrast against both a light and a dark shade. -->
    <color name="notification_accent">#B23A7A</color>

    <!-- Meu trajeto line identities for the followed-bus notification, which
         can't read MaterialTheme. Mirror the design-system `MelonTransitColors`
         (light here, dark in values-night). -->
    <color name="notification_transit_003">#2D1B4E</color>
    <color name="notification_transit_087">#B23A7A</color>
    <color name="notification_transit_088">#E85D4E</color>
</resources>
