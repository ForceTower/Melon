<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Evaluation-reminder alarms are RTC and die with a reboot; the boot
         broadcast re-arms them from the on-disk snapshot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:name=".MelonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Melon">
        <!-- singleTop so a notification tap while the app is open lands in
             onNewIntent instead of stacking a second MainActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Melon.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unes" />
            </intent-filter>
        </activity>

        <!-- Grants external viewers read access to the offline document slots
             under filesDir/documents (Comprovante / Histórico) and to the
             downloaded material attachments under cacheDir/materials. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <service
            android:name=".firebase.MelonFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- `notification`-payload pushes are drawn by the FCM SDK itself, not
             by MelonFirebaseMessagingService. Without these it falls back to
             `android:icon` for the small icon — and since the launcher icon is
             fully opaque, the platform's alpha-only tint turns it into a solid
             blob, which OEM skins then stack the launcher badge on top of.
             A payload-level `icon` still overrides both. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_unes" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- "Próxima aula" home-screen widget. The receiver runs in the host
             app process; Glance handles the actual RemoteViews rendering.
             `TIME_SET` / `TIMEZONE_CHANGED` keep the countdown honest when the
             user manually changes the clock or crosses a TZ boundary —
             without these we'd render against the new wall time only on the
             next AlarmManager tick (which can be minutes away in Doze).
             Both are protected broadcasts (system-only sender). -->
        <receiver
            android:name=".widgets.NextClassWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_next_class_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_class_widget_info" />
        </receiver>

        <!-- Glance ships an invisible trampoline activity used *only* to relay
             clicks on lazy-collection (LazyColumn / LazyVerticalGrid) items
             whose action is a broadcast, service or `actionRunCallback` — it
             reads the real target out of the launching intent's ACTION_INTENT
             extra and `requireNotNull`s it.

             This widget has no lazy collections and its only action is
             `actionStartActivity<MainActivity>()`, which Glance wires as a
             direct PendingIntent and never routes through the trampoline. So
             nothing here can ever produce an intent carrying that extra, and
             any launch of the activity — a task relaunched from Recents (its
             base intent is persisted without extras) or a stale PendingIntent
             replayed by a launcher — crashes the process on arrival with
             "List adapter activity trampoline invoked without specifying
             target intent". Dropping the declaration turns that into a failed
             launch in system_server instead of a fatal exception in ours.

             Re-add this (delete the node) if the widget ever grows a Glance
             lazy list with a non-activity action — those clicks need it. -->
        <activity
            android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            tools:node="remove" />

        <!-- Evening-before evaluation reminders: fires the local notification
             from the on-disk snapshot and re-arms after boot / clock changes
             (all protected broadcasts, so the receiver stays unexported). -->
        <receiver
            android:name=".reminders.EvaluationReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".reminders.PersonalEventReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
